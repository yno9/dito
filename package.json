{
  "name": "did-md",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "bun build client/app.ts --target browser --outfile build/app.js --loader .html:text",
    "build:home": "bun build.ts",
    "build:bridge": "bun build --compile --target=bun-linux-x64 --outfile dist/did-md-oidc-bridge server/oauth/src/server.ts",
    "dev": "bun --watch server/server.ts",
    "start": "bun server/server.ts",
    "start:bridge": "bun server/oauth/src/server.ts",
    "test": "bun test",
    "dito": "bun packages/cli/dito.ts",
    "conformance": "bun packages/webvh/conformance-cli.ts",
    "start:identity": "bun server/host/http-server.ts",
    "build:identity": "bun build --compile --target=bun-linux-x64 --outfile dist/did-md-server server/host/http-server.ts"
  },
  "dependencies": {
    "@metamask/browser-passworder": "^6.0.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@octokit/core": "^7.0.8",
    "@scure/bip39": "^2.4.0",
    "didwebvh-ts": "^2.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2"
  },
  "license": "AGPL-3.0-only",
  "description": "A generic did:webvh wallet, a did:webvh hosting protocol, and a reference host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yno9/dito.git"
  }
}
